<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Swastik Shukla</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --red: #e8192c;
    --green: #8fbc5a;
    --dark: #0d0d0d;
    --card: #161616;
    --muted: #888;
    --white: #f5f5f5;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--dark);
    color: var(--white);
    font-family: 'Outfit', sans-serif;
    overflow-x: hidden;
    cursor: default;
  }

  /* ── NOISE OVERLAY ── */
  body::before {
    content: '';
    position: fixed; inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 999;
    opacity: 0.35;
  }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; width: 100%; z-index: 100;
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.2rem 3rem;
    background: rgba(13,13,13,0.85);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid #222;
  }
  .nav-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.6rem;
    letter-spacing: 3px;
    color: var(--white);
  }
  .nav-logo span { color: var(--red); }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a {
    color: var(--muted); text-decoration: none;
    font-size: 0.85rem; letter-spacing: 1px; text-transform: uppercase;
    transition: color .3s;
  }
  .nav-links a:hover { color: var(--white); }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 0 6rem;
    gap: 4rem;
    position: relative;
    overflow: hidden;
  }
  .hero::after {
    content: 'SS';
    position: absolute;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 40vw;
    color: rgba(255,255,255,0.018);
    right: -5vw; bottom: -8vw;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .hero-text { position: relative; z-index: 2; }
  .hero-tag {
    display: inline-block;
    background: var(--red);
    color: #fff;
    font-size: 0.7rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    padding: 0.3rem 0.9rem;
    margin-bottom: 1.5rem;
    animation: fadeUp .6s ease both;
  }
  .hero-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: 2px;
    animation: fadeUp .7s .1s ease both;
  }
  .hero-name .accent { color: var(--red); }
  .hero-sub {
    margin-top: 1.5rem;
    font-size: 1rem;
    color: var(--muted);
    max-width: 380px;
    line-height: 1.7;
    animation: fadeUp .7s .2s ease both;
  }
  .hero-badges {
    display: flex; gap: 0.8rem; margin-top: 2rem;
    animation: fadeUp .7s .3s ease both;
    flex-wrap: wrap;
  }
  .badge {
    padding: 0.45rem 1.1rem;
    border: 1px solid #333;
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--muted);
    display: flex; align-items: center; gap: 0.5rem;
    transition: border-color .3s, color .3s;
  }
  .badge:hover { border-color: var(--red); color: var(--white); }
  .badge .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); }

  /* ── PHOTO ── */
  .hero-photo-wrap {
    position: relative;
    display: flex; justify-content: center; align-items: flex-end;
    animation: fadeUp .8s .15s ease both;
  }
  .hero-photo-wrap::before {
    content: '';
    position: absolute;
    width: 350px; height: 350px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(232,25,44,0.18) 0%, transparent 70%);
    top: 50%; left: 50%;
    transform: translate(-50%,-50%);
  }
  .photo-frame {
    width: 340px; height: 430px;
    border-radius: 180px 180px 120px 120px;
    overflow: hidden;
    border: 2px solid #2a2a2a;
    position: relative;
    box-shadow: 0 0 80px rgba(232,25,44,0.15), 0 40px 80px rgba(0,0,0,0.6);
  }
  .photo-frame img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: contrast(1.05) saturate(1.1);
    transition: transform .6s ease;
  }
  .photo-frame:hover img { transform: scale(1.04); }
  .photo-frame::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(13,13,13,0.5) 0%, transparent 50%);
  }

  /* ── SECTION SHARED ── */
  section { padding: 5rem 6rem; }
  .section-label {
    font-size: 0.7rem;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 0.6rem;
  }
  .section-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    letter-spacing: 1px;
    margin-bottom: 2.5rem;
  }

  /* ── INTERESTS ── */
  .interests { background: #111; }
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }
  .card {
    background: var(--card);
    border: 1px solid #222;
    border-radius: 16px;
    padding: 2rem 1.8rem;
    position: relative;
    overflow: hidden;
    transition: transform .3s, border-color .3s, box-shadow .3s;
  }
  .card:hover {
    transform: translateY(-6px);
    border-color: var(--red);
    box-shadow: 0 20px 50px rgba(232,25,44,0.12);
  }
  .card-icon { font-size: 2.5rem; margin-bottom: 1rem; }
  .card-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.5rem;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
  }
  .card-desc { font-size: 0.88rem; color: var(--muted); line-height: 1.6; }

  /* ── CONTACT ── */
  .contact {
    background: var(--dark);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .contact-links { display: flex; flex-direction: column; gap: 1.2rem; }
  .contact-item {
    display: flex; align-items: center; gap: 1.2rem;
    padding: 1.2rem 1.5rem;
    border: 1px solid #222;
    border-radius: 12px;
    background: var(--card);
    text-decoration: none;
    color: var(--white);
    transition: border-color .3s, transform .3s;
  }
  .contact-item:hover {
    border-color: var(--red);
    transform: translateX(8px);
  }
  .contact-icon {
    width: 44px; height: 44px;
    background: #1e1e1e;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
  }
  .contact-label { font-size: 0.72rem; color: var(--muted); letter-spacing: 1px; text-transform: uppercase; }
  .contact-value { font-size: 0.95rem; margin-top: 0.1rem; }

  .contact-big {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1.1;
    letter-spacing: 1px;
  }
  .contact-big .red { color: var(--red); }

  /* ── FOOTER ── */
  footer {
    text-align: center;
    padding: 2rem;
    border-top: 1px solid #1e1e1e;
    font-size: 0.8rem;
    color: #444;
    letter-spacing: 1px;
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    nav { padding: 1rem 1.5rem; }
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 8rem 2rem 4rem;
      gap: 3rem;
    }
    .hero-sub { margin: 1.5rem auto 0; }
    .hero-badges { justify-content: center; }
    .hero-photo-wrap { order: -1; }
    .photo-frame { width: 260px; height: 330px; }
    section { padding: 4rem 1.8rem; }
    .contact { grid-template-columns: 1fr; }
  }
</style>
</head>
